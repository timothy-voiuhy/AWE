{
  "key": "php2shell",
  "display_name": "php2shell",
  "repository": "https://github.com/timothy-voiuhy/php2shell-poc",
  "revision": "93df49253e79774e61833938c40aff3b79c6bde1",
  "command_template": "python -u /poc/poc/exploit_chain_{chain}.py --target '{target}'",
  "dockerfile": "FROM python:3.12-slim\nWORKDIR /poc\nCOPY . /poc\nRUN python -m compileall -q poc && mkdir -p /output\nENV PYTHONUNBUFFERED=1\n",
  "param_specs": [
    {"key": "target", "label": "Lab URL", "type": "text", "default": ""},
    {"key": "chain", "label": "Chain", "type": "combo", "default": "a", "options": ["a", "c"]}
  ],
  "execution_kind": "interactive",
  "output_channels": ["logs", "artifacts", "session"],
  "artifact_paths": ["**/*"],
  "execution_timeout": 3600,
  "session_idle_timeout": 3600
}
