# Public DNS name used by Caddy. Use localhost only for local testing.
AWE_HOST=awe.example.com

# Generate with: openssl rand -hex 32
AWE_SECRET_KEY=replace-with-a-long-random-secret

# Generate with: awe-backend/.venv/bin/python -m awe_backend.password
# Dollar signs must be doubled in Compose .env files: replace each $ with $$.
AWE_ADMIN_PASSWORD_HASH=replace-with-generated-argon2-hash
