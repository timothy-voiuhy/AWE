# Public DNS name used by Caddy. Use localhost only for local testing.
AWE_HOST=awe.example.com

# Generate with: openssl rand -hex 32
AWE_SECRET_KEY=replace-with-a-long-random-secret

# The first browser visit creates a local account interactively. For unattended
# deployment you may instead set AWE_ADMIN_PASSWORD_HASH to an Argon2 hash.
