FROM golang:1.24-bookworm AS builder
RUN go install github.com/sensepost/gowitness/v3@latest

FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    chromium ca-certificates fonts-liberation libnss3 libatk1.0-0 \
    libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 \
    libxdamage1 libxrandr2 libgbm1 libasound2 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /go/bin/gowitness /usr/local/bin/gowitness
ENV GOWITNESS_CHROME_PATH=/usr/bin/chromium
RUN mkdir -p /output/screenshots
WORKDIR /output
ENTRYPOINT ["gowitness"]
