FROM golang:1.24-bookworm AS builder
ENV GOTOOLCHAIN=auto
RUN go install github.com/sensepost/gowitness@latest

# chromedp/headless-shell is the runtime image gowitness's own maintainers
# ship it on — a minimal, purpose-built headless Chrome without the desktop
# Chromium package's dbus/D-Bus service probing, which crashes/hangs in a
# plain debian+apt-installed-chromium container.
FROM docker.io/chromedp/headless-shell:stable
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    tini ca-certificates && rm -rf /var/lib/apt/lists/*
RUN ln -sf /headless-shell/headless-shell /usr/bin/google-chrome && \
    ln -sf /headless-shell/headless-shell /usr/bin/chromium && \
    ln -sf /headless-shell/headless-shell /usr/bin/chromium-browser
COPY --from=builder /go/bin/gowitness /usr/local/bin/gowitness
ENV GOWITNESS_CHROME_PATH=/headless-shell/headless-shell
RUN mkdir -p /output/screenshots
WORKDIR /output
ENTRYPOINT ["tini", "--", "gowitness"]
