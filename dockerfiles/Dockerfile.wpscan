FROM ruby:3.3-slim

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git libcurl4-openssl-dev \
    libyaml-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN gem install --no-document wpscan
RUN mkdir -p /output /tmp/wpscan
ENV XDG_CACHE_HOME=/tmp/wpscan
ENTRYPOINT ["wpscan"]
