FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
COPY src /app/src
RUN python -m pip install --no-cache-dir "httpx>=0.27,<1" "cryptography>=42,<47" "pymongo>=4.6,<5"

EXPOSE 8080 8765
CMD ["python", "-m", "proxy.server", "--host", "0.0.0.0", "--port", "8080"]
